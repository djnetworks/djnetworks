SUPABASE_URL=https://hkzgxsgokqphthdmbras.supabase.co

# Supabase now issues a PUBLISHABLE key rather than an anon JWT.
# This key is PUBLIC by design — it ships inside the static frontend and anyone
# can read it out of the page source. It is not a secret and must not be treated
# as one. RLS is the only thing standing between it and the data.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Never commit the service role key. Never paste it into a chat.
